{
  "name": "web-cv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.x"
  },
  "scripts": {
    "dev": "next dev --port ${PLAYWRIGHT_PORT:-3200}",
    "build": "bun run install:cv-browser && bun run generate:brand && bun run generate:og-fonts && bun run generate:cv && next build",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "generate:cv": "node scripts/generate-cv-pdf.mjs",
    "generate:og-fonts": "bun run scripts/subset-og-fonts.ts",
    "generate:path-cards": "bun run scripts/prepare-path-cards.ts",
    "generate:path-stills": "bun run scripts/render-path-stills.ts",
    "install:cv-browser": "playwright install chromium --only-shell",
    "start": "next start",
    "verify:hosts": "bun run scripts/verify-production-hosts.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "generate:path-voice": "bun run scripts/generate-path-voice.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^0.469.0",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "sharp": "^0.34.4",
    "tailwind-merge": "^2.6.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "pdfjs-dist": "^6.1.200",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4",
    "typescript": "^5.7"
  }
}
