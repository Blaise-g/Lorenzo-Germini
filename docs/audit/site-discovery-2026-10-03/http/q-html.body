="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path></svg></a></div></div></div></div><nav aria-label="On this page" class="border-border font-label -mx-1 flex flex-wrap gap-x-1 gap-y-4 border-y py-1 text-xs tracking-[0.08em] uppercase print:hidden mt-5 lg:hidden"><a href="#writing" class="touch-target text-faint hover:text-accent px-2 py-1.5 underline-offset-4 hover:underline">Writing</a><a href="#about" class="touch-target text-faint hover:text-accent px-2 py-1.5 underline-offset-4 hover:underline">About</a><a href="#work" class="touch-target text-faint hover:text-accent px-2 py-1.5 underline-offset-4 hover:underline">Work</a><a href="#projects" class="touch-target text-faint hover:text-accent px-2 py-1.5 underline-offset-4 hover:underline">Projects</a><a href="#systems" class="touch-target text-faint hover:text-accent px-2 py-1.5 underline-offset-4 hover:underline">Systems</a></nav><div class="grid gap-10 pt-7 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-14 lg:pt-10 print:block print:pt-0"><aside aria-label="Profile and page sections" data-profile-orientation="identity" class="hidden space-y-6 self-start lg:sticky lg:top-8 lg:col-start-1 lg:row-start-1 lg:block print:hidden"><div class="space-y-4"><div class="space-y-4"><div class="border-accent/20 portrait-warm relative h-45 w-36 overflow-hidden rounded-sm border-2"><img alt="Lorenzo Germini" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="144px" srcSet="/_next/image?url=%2Florenzo-germini-portrait.jpg&amp;w=32&amp;q=75&amp;dpl=dpl_A9rXGX5umNK7doEpmuVDCvnb3vEE 32w, /_next/image?url=%2Florenzo-germini-portrait.jpg&amp;w=48&amp;q=75&amp;dpl=dpl_A9rXGX5umNK7doEpmuVDCvnb3vEE 48w, /_next/image?url=%2Florenzo-germini-portrait.jpg&amp;w=64&amp;q=75&amp;dpl=dpl_A9rXGX5umNK7doEpmuVDCvnb3vEE 64w, 