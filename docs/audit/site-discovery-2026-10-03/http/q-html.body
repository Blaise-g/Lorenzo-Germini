e focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-border bg-ground text-ink hover:border-accent hover:text-accent h-11 w-11 print:size-8"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail size-4 print:size-5"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg></a><a href="https://github.com/Blaise-g" aria-label="GitHub" class="ring-offset-ground inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-refined focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-border bg-ground text-ink hover:border-accent hover:text-accent h-11 w-11 print:size-8"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 print:h-5 print:w-5"><title>GitHub</title><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg></a><a href="https://www.linkedin.com/in/lorenzogermini/" aria-label="LinkedIn" class="ring-offset-ground inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-refined focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-border bg-ground text-ink hover:border-accent hover:text-accent h-11 w-11 print:size-8"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 print:h-5 print:w-5"><title>LinkedIn</title><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg></a><a href="https://twitter.com/spleenboi_" aria-label="X" class="ring-offset-ground inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-refined focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-border bg-ground text-ink hover:border-accent hover:text-accent h-11 w-11 print:size-8"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 print:h-5 print:w-5"><title>X</title><path fill="currentColor" d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path></svg></a></div></div></div><nav aria-label="Page sections" class="border-border font-label flex flex-col border-t pt-4 text-xs tracking-[0.12em] uppercase"><a href="#writing" aria-current="location" class="inline-flex min-h-6 items-center border-l py-1.5 pl-3 underline-offset-4 coarse:py-3.5 hover:text-accent transition-colors hover:underline border-l-accent text-accent">Writing</a><a href="#about" class="inline-flex min-h-6 items-center border-l py-1.5 pl-3 underline-offset-4 coarse:py-3.5 hover:text-accent transition-colors hover:underline text-faint border-l-transparent">About</a><a href="#work" class="inline-flex min-h-6 items-center border-l py-1.5 pl-3 underline-offset-4 coarse:py-3.5 hover:text-accent transition-colors hover:underline text-faint border-l-transparent">Work</a><a href="#projects" class="inline-flex min-h-6 items-center border-l py-1.5 pl-3 underline-offset-4 coarse:py-3.5 hover:text-accent transition-colors hover:underline text-faint border-l-transparent">Projects</a><a href="#systems" class="inline-flex min-h-6 items-center border-l py-1.5 pl-3 underline-offset-4 coarse:py-3.5 hover:text-accent transition-colors hover:underline text-faint border-l-transparent">Systems</a><a href="/cv" class="inline-flex min-h-6 items-center border-l py-1.5 pl-3 underline-offset-4 coarse:py-3.5 text-accent decoration-border hover:decoration-accent mt-3 border-l-transparent underline">CV →</a></nav></aside><div class="min-w-0 space-y-12 lg:col-start-2 lg:row-start-1 print:space-y-5"><section class="flex min-h-0 flex-col animate-fade-in-up max-w-[42rem] scroll-mt-24 print:gap-y-1 gap-y-0" data-reading-measure="true"><h1 class="font-display text-[clamp(2rem,5.2vw,3.25rem)] leading-[1.08] font-medium tracking-tight text-pretty">I build AI products end-to-end and write about <em class="text-accent italic">what actually works</em>.</h1><p class="text-body mt-6 text-base leading-relaxed text-pretty print:mt-2 print:text-[12px]">Right now that&#x27;s the AI engine behind Complaion, a compliance platform for ISO certifications: LLM agents doing real compliance work in the background, and the evals that show when they can&#x27;t be trusted. Before that: pharma manufacturing, digital health, and a GenAI startup.</p><a href="#writing" class="text-accent border-accent touch-target font-label mt-7 self-start border-b-2 pb-0.5 text-xs tracking-[0.12em] uppercase hover:opacity-70 print:hidden">Start with the writing ↓</a></section><section class="flex min-h-0 flex-col gap-y-3 animate-fade-in-up max-w-[42rem] scroll-mt-24 print:gap-y-1" id="writing" data-reading-measure="true"><h2 class="text-accent font-label text-[15px] font-semibold tracking-[0.18em] uppercase">Writing</h2><div class="bg-accent/30 h-px w-12"></div><p class="text-body text-base leading-relaxed text-pretty print:text-[12px]">Field notes, mostly from building with AI, published on germinai. No definitive guides. Things I tried, what broke, and what earned its place.</p><article class="group mt-2"><p class="text-faint font-label text-xs tracking-[0.12em] uppercase">4 Aug 2026<!-- --> ·<!-- --> <!-- -->5<!-- --> min read</p><h3 class="font-display mt-2 text-2xl leading-snug sm:text-3xl"><a class="touch-target underline-offset-4 group-hover:underline" href="https://lorenzogermini.substack.com/p/drop-the-bloat" target="_blank" rel="noopener noreferrer">Drop the Bloat</a></h3><p class="text-body mt-3 text-base leading-relaxed text-pretty print:text-[12px]">Everything you hand a coding agent, it has to carry. Mine was hauling 35K tokens of instructions before I typed a word. A field note on cutting that to 13K, and on knowing when context stops earning its place.</p><p class="mt-4 flex flex-col items-start gap-y-5 sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-6"><a class="text-accent border-accent touch-target font-label border-b pb-0.5 text-xs tracking-[0.12em] uppercase hover:opacity-70" href="https://lorenzogermini.substack.com/p/drop-the-bloat" target="_blank" rel="noopener noreferrer">Read the field note →</a><a class="text-faint hover:text-accent decoration-border hover:decoration-accent touch-target font-label text-xs tracking-[0.12em] uppercase underline underline-offset-4 print:hidden" href="/writing">All writing →</a></p></article></section><section class="flex min-h-0 flex-col gap-y-3 animate-fade-in-up max-w-[42rem] scroll-mt-24 print:gap-y-1" id="about" data-reading-measure="true"><h2 class="text-accent font-label text-[15px] font-semibold tracking-[0.18em] uppercase">About</h2><div class="bg-accent/30 h-px w-12"></div><div class="text-body space-y-3 text-base leading-relaxed text-pretty print:space-y-1 print:text-[12px] print:leading-[1.35]"><p>I&#x27;m an AI product engineer: I ship AI products end-to-end, from the models and infrastructure to the interface people actually touch, and stay on the hook for whether the thing helps anyone. Full stack in the literal sense: backend, frontend, and the product calls in between.</p><p>These days that&#x27;s the AI engine behind Complaion, a compliance platform for European SMEs getting and keeping ISO certifications. The interesting problem is making the agents in the background reliable enough to trust with real compliance work, and knowing when they&#x27;re not. Before that: AI for pharma manufacturing at GSK, AI R&amp;D in digital health, and a GenAI EdTech startup I built as founding engineer. The through-line hasn&#x27;t changed: technical depth only matters when it meets a real user problem.</p><p>Outside work: sports, side projects, and rabbit holes on tech entrepreneurship and biohacking.</p></div></section><section class="flex min-h-0 flex-col gap-y-3 animate-fade-in-up max-w-[42rem] scroll-mt-24 print:gap-y-1" id="work" data-reading-measure="true"><h2 class="text-accent font-label text-[15px] font-semibold tracking-[0.18em] uppercase">Work</h2><div class="bg-accent/30 h-px w-12"></div><div class="space-y-7 print:space-y-1"><div class="print-keep-together grid gap-1 sm:grid-cols-[8rem_1fr] sm:gap-6"><p class="text-faint font-mono text-xs tabular-nums sm:pt-1.5">May 2025<!-- --> – <!-- -->Present</p><div><h3 class="font-display text-xl leading-snug">AI Engineer<!-- --> ·<!-- --> <a class="touch-target underline-offset-4 hover:underline" href="https://www.complaion.com/">Complaion</a></h3><p class="text-body mt-1.5 text-sm leading-relaxed text-pretty print:text-[12px]">The AI engine behind the product: LLM agents doing compliance work over ISO documentation in the background, and the eval harness that shows when they can&#x27;t be trusted. Shipping features end-to-end, from definition through AI, backend, and frontend to production.</p></div></div><div class="print-keep-together grid gap-1 sm:grid-cols-[8rem_1fr] sm:gap-6"><p class="text-faint font-mono text-xs tabular-nums sm:pt-1.5">Nov 2024<!-- --> – <!-- -->Apr 2025</p><div><h3 class="font-display text-xl leading-snug">Founding AI Engineer<!-- --> ·<!-- --> <!-- -->Stealth GenAI Startup</h3><p class="text-body mt-1.5 text-sm leading-relaxed text-pretty print:text-[12px]">Backend and GenAI API layer from zero on AWS; a RAG stack with custom parsing for handwritten input, plus the tracing and evals to tune retrieval.</p></div></div><div class="print-keep-together grid gap-1 sm:grid-cols-[8rem_1fr] sm:gap-6"><p class="text-faint font-mono text-xs tabular-nums sm:pt-1.5">Sep 2023<!-- --> – <!-- -->Oct 2024</p><div><h3 class="font-display text-xl leading-snug">AI Engineer<!-- --> ·<!-- --> <a class="touch-target underline-offset-4 hover:underline" href="https://www.gsk.com/en-gb/home/">GSK</a></h3><p class="text-body mt-1.5 text-sm leading-relaxed text-pretty print:text-[12px]">Time-series forecasting and anomaly detection on plant sensor data, semantic NLP for fault detection, and a water-rejection strategy projected at 10,000 m³/year.</p></div></div><div class="print-keep-together grid gap-1 sm:grid-cols-[8rem_1fr] sm:gap-6"><p class="text-faint font-mono text-xs tabular-nums sm:pt-1.5">2021<!-- --> – <!-- -->2023</p><ul class="text-faint space-y-1 text-sm leading-relaxed text-pretty print:text-[12px]"><li>A Stable Diffusion interior-design MVP, killed on the evidence</li><li>Biomedical-literature summarisation at Burgeon Labs</li><li>Fill-parameter ML at Roche</li><li>EPFL MSc, Life Sciences Engineering</li></ul></div></div><p class="mt-3 print:hidden"><a href="/cv" class="text-accent border-accent touch-target font-label border-b pb-0.5 text-xs tracking-[0.12em] uppercase hover:opacity-70">Full CV →</a></p></section><section class="flex min-h-0 flex-col gap-y-3 animate-fade-in-up max-w-[42rem] scroll-mt-24 print:gap-y-1 print-projects-section scroll-mb-16 lg:max-w-none" id="projects" data-reading-measure="true"><h2 class="text-accent font-label text-[15px] font-semibold tracking-[0.18em] uppercase">Projects</h2><div class="bg-accent/30 h-px w-12 print:my-1"></div><div data-testid="projects-grid" class="grid grid-cols-1 gap-3 print:mx-0 print:grid-cols-2 print:gap-2 lg:grid-cols-2"><div class="border-border bg-ground text-ink rounded-lg border print:rounded-none print:border-none print:bg-transparent print:shadow-none card-hover print-keep-together group border-l-border hover:border-l-accent flex flex-col overflow-hidden border-l p-3 print:p-1"><div class="flex flex-col space-y-1.5"><div class="space-y-1"><h3 class="tracking-tight font-display text-base font-semibold"><a href="https://quadrell.dev/" target="_blank" rel="noopener noreferrer" class="touch-target transition-refined group-hover:text-accent items-center gap-1.5 hover:underline">Quadrell</a></h3><p class="text-body text-sm print:text-[12px]">My independent studio for websites and workflow automations, built around how small businesses and independent professionals work. I take projects from the initial brief to launch, including a hospitality site for Alpes d’OC and an artist portfolio for Angelica Nolasco.</p></div></div><div class="text-body text-sm text-pretty mt-auto flex"><div class="mt-2 flex flex-wrap gap-1"><div data-slot="badge" class="inline-flex items-center rounded-md border bg-ground font-mono font-medium text-nowrap border-border text-faint px-1 py-0 text-xs print:px-1 print:py-0.5 print:text-[12px] print:leading-tight">Independent Studio</div><div data-slot="badge" class="inline-flex items-center rounded-md border bg-ground font-mono font-medium text-nowrap border-border text-faint px-1 py-0 text-xs print:px-1 print:py-0.5 print:text-[12px] print:leading-tight">Websites</div><div data-slot="badge" class="inline-flex items-center rounded-md border bg-ground font-mono font-medium text-nowrap border-border text-faint px-1 py-0 text-xs print:px-1 print:py-0.5 print:text-[12px] print:leading-tight">Automations</div></div></div></div><div class="border-border bg-ground text-ink rounded-lg border print:rounded-none print:border-none print:bg-transparent print:shadow-none card-hover print-keep-together group border-l-border hover:border-l-accent flex flex-col overflow-hidden border-l p-3 print:p-1"><div class="flex flex-col space-y-1.5"><div class="space-y-1"><h3 class="tracking-tight font-display text-base font-semibold"><a href="https://ghigliottina.vercel.app/" target="_blank" rel="noopener noreferrer" class="touch-target transition-refined group-hover:text-accent items-center gap-1.5 hover:underline">L&#x27;Oracolo della Ghigliottina</a></h3><p class="text-body text-sm print:text-[12px]">An archived AI game companion for La Ghigliottina, the cult final round of Italy&#x27;s most-watched quiz show. It found the word connecting five clues submitted as text or a photo of the TV, with rate-limit handling. The service is now closed; past results remain available to browse.</p></div></div><div class="text-body text-sm text-pretty mt-auto flex"><div class="mt-2 flex flex-wrap gap-1"><div data-slot="badge" class="inline-flex items-center rounded-md border bg-ground font-mono font-medium text-nowrap border-border text-faint px-1 py-0 text-xs print:px-1 print:py-0.5 print:text-[12px] print:leading-tight">Side Project</div><div data-slot="badge" class="inline-flex items-center rounded-md border bg-ground font-mono font-medium text-nowrap border-border text-faint px-1 py-0 text-xs print:px-1 print:py-0.5 print:text-[12px] print:leading-tight">Archived</div></div></div></div></div></section><section class="flex min-h-0 flex-col gap-y-3 animate-fade-in-up max-w-[42rem] scroll-mt-24 print:gap-y-1" id="systems" data-reading-measure="true"><h2 class="text-accent font-label text-[15px] font-semibold tracking-[0.18em] uppercase">Systems</h2><div class="bg-accent/30 h-px w-12"></div><p class="text-body font-mono text-xs leading-relaxed">agent systems · eval harnesses &amp; tracing · end-to-end shipping, coding agents in the loop</p></section></div></div></div><div class="fixed right-4 bottom-4 z-50 hidden xl:block print:hidden"><button class="ring-offset-ground inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-refined focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-border bg-ground text-ink hover:text-accent h-11 w-11 hover:border-accent rounded-full shadow-lg pointer-events-none translate-y-2 scale-95 opacity-0" aria-label="Back to top" aria-hidden="true" tabindex="-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up h-4 w-4"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div></div></main><footer class="mx-auto max-w-5xl px-6 md:px-10 print:max-w-none print:px-0 pb-20 print:pb-0"><div class="flex w-full flex-col gap-5 border-t pt-6 text-sm sm:flex-row sm:items-end sm:justify-between print:hidden"><div class="space-y-1"><p class="font-semibold">Lorenzo Germini</p><p class="text-faint font-mono text-xs">Cuneo, Italy, CET</p></div><div class="space-y-5 sm:text-right"><nav aria-label="Footer"><ul class="flex flex-wrap gap-x-4 gap-y-5 sm:justify-end"><li><a class="touch-target underline decoration-b