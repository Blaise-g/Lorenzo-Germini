ased"><div hidden=""><!--$--><!--/$--></div><a href="#main-content" class="focus:bg-accent focus:text-accent-foreground sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-md focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:shadow-lg print:hidden">Skip to content</a><!--&--><!--&--><script type="application/ld+json">{"@context":"https://schema.org","@type":"Blog","name":"germinai","url":"https://lorenzogermini.substack.com","mainEntityOfPage":"https://lorenzogermini.com/writing","description":"Field notes, mostly from building with AI and the people building on it. No definitive guides. The advice changes every two days anyway. Published on germinai.","inLanguage":"en","author":{"@id":"https://lorenzogermini.com/#person"}}</script><main id="main-content" tabindex="-1" class="scroll-mt-12 focus-visible:shadow-none"><div class="min-h-screen"><div class="border-ink border-b-2"><header class="mx-auto max-w-[46rem] px-6 print:max-w-none print:px-0 py-3 lg:py-4"><div class="flex items-center justify-between gap-8"><a data-identity-name="true" class="touch-target font-display text-lg font-semibold tracking-tight underline-offset-4 hover:underline" href="/">Lorenzo Germini</a><div class="flex items-center gap-6"><nav aria-label="Site" class="text-faint flex gap-5 print:hidden font-label text-xs uppercase tracking-[0.12em]"><a class="touch-target hover:text-accent underline-offset-4 hover:underline" href="/">Home</a><a href="/cv" class="touch-target hover:text-accent underline-offset-4 hover:underline">CV</a></nav><button class="ring-offset-ground inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-refined focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-border bg-ground text-faint touch-target hover:border-accent hover:text-ink h-9 w-9 rounded-full print:hidden" data-testid="theme-toggle" aria-label="Light mode" aria-pressed="false"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon transition-refined h-4 w-4"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg></button></div></div></header></div><div class="mx-auto max-w-[46rem] px-6 print:max-w-none print:px-0 pb-24"><div class="max-w-[34rem] pt-12"><h1 class="font-display animate-fade-in-up text-4xl leading-[1.1] font-medium tracking-tight">Writing</h1><p class="text-body animate-fade-in-up mt-4 text-base leading-relaxed text-pretty">Field notes, mostly from building with AI and the people building on it. No definitive guides. The advice changes every two days anyway. Published on germinai.</p><p class="text-faint animate-fade-in-up mt-3 font-label uppercase tracking-[0.12em] text-xs/relaxed">First post published 4 Aug 2026 · new ones when there&#x27;s something worth the send</p></div><div class="mt-14"><article class="group animate-fade-in-up relative"><div class="border-border relative aspect-[16/9] w-full overflow-hidden rounded-sm border"><img alt="" fetchPriority="high" loading="eager" decoding="async" data-nimg="fill" class="object-cover dark:brightness-[0.82]" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 768px) 42rem, 100vw" srcSet="/_next/image?url=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb74ed7dc-74b7-482a-a806-1072337fed5b_1456x819.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb74ed7dc-74b7-482a-a806-1072337fed5b_1456x819.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb74ed7dc-74b7-482a-a806-1072337fed5b_1456x819.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2F